<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login – 🔥 VillasGame</title>

  <!-- Global styles (navbar, footer, layout, etc.) -->
  <link rel="stylesheet" href="/css/style.css" />

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #1b1b3a 0, #050509 55%, #000 100%);
      color: #fff;
      min-height: 100vh;
    }

    /* Wrapper under navbar & above footer */
    .auth-page {
      min-height: calc(100vh - 150px);
      padding: 100px 16px 40px; /* 100px so content comes under navbar */
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .auth-card {
      width: 100%;
      max-width: 420px;
      background: linear-gradient(145deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
      border-radius: 20px;
      padding: 26px 26px 24px;
      box-shadow:
        0 18px 45px rgba(0,0,0,0.65),
        0 0 0 1px rgba(255,255,255,0.03);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    .auth-badge {
      width: 64px;
      height: 64px;
      border-radius: 999px;
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 30% 20%, #ffce6b 0, #ff4d4d 40%, #ff007a 85%);
      box-shadow: 0 0 20px rgba(255, 77, 77, 0.5);
      font-size: 30px;
    }

    .auth-title {
      text-align: center;
      font-size: 26px;
      font-weight: 700;
      margin: 6px 0 2px;
    }

    .auth-subtitle {
      text-align: center;
      font-size: 14px;
      color: #c2c2d6;
      margin-bottom: 20px;
    }

    .input-row {
      margin-bottom: 14px;
      width: 100%;
    }

    .input-label {
      display: block;
      font-size: 13px;
      margin-bottom: 6px;
      color: #d8d8e5;
    }

    .input-wrapper {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-radius: 12px;
      background: rgba(15,15,25,0.96);
      border: 1px solid rgba(255,255,255,0.06);
      transition: border 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    .input-wrapper:focus-within {
      border-color: #ff4d4d;
      box-shadow: 0 0 0 1px rgba(255,77,77,0.6);
      background: rgba(15,15,30,0.98);
    }

    .input-icon {
      font-size: 16px;
      opacity: 0.85;
    }

    .input-field {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      color: #fff;
      font-size: 14px;
    }

    .input-field::placeholder {
      color: #7e7f92;
    }

    .primary-btn {
      width: 100%;
      border: none;
      outline: none;
      border-radius: 999px;
      padding: 11px 14px;
      margin-top: 10px;
      background: linear-gradient(135deg, #ff7a4d, #ff4d4d);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.02em;
      box-shadow: 0 12px 30px rgba(255,77,77,0.5);
      transition: transform 0.12s ease, box-shadow 0.12s ease, opacity 0.12s ease;
    }

    .primary-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 15px 40px rgba(255,77,77,0.7);
      opacity: 0.96;
    }

    .primary-btn:active {
      transform: translateY(0);
      box-shadow: 0 8px 18px rgba(0,0,0,0.7);
      opacity: 0.92;
    }

    .auth-footer-text {
      text-align: center;
      margin-top: 14px;
      color: #b0b0c4;
      font-size: 14px;
    }

    .auth-footer-text a {
      color: #ff6b6b;
      text-decoration: none;
      font-weight: 600;
    }

    .auth-footer-text a:hover {
      text-decoration: underline;
    }

    .errorBox {
      background: rgba(255, 77, 77, 0.09);
      border: 1px solid rgba(255, 77, 77, 0.65);
      color: #ffb7b7;
      text-align: center;
      margin-bottom: 14px;
      padding: 8px 10px;
      font-size: 13px;
      border-radius: 10px;
    }

    @media (max-width: 480px) {
      .auth-page {
        padding: 90px 14px 32px;
      }

      .auth-card {
        padding: 22px 18px 20px;
        border-radius: 18px;
      }

      .auth-title {
        font-size: 22px;
      }

      .auth-subtitle {
        font-size: 13px;
      }
    }
  </style>
</head>

<body>
  <!-- SAME NAVBAR AS HOME -->
  <header class="navbar">
    <div class="logo">🔥 VillasGame</div>
    <div class="hamburger" id="hamburger">&#9776;</div>
    <nav class="nav-links">
      <a href="#">Newest</a>
      <a href="#">Most popular</a>
      <a href="#">Random</a>
    </nav>
    <div class="search-bar">
      <input type="text" placeholder="Search games..." autocomplete="off" />
    </div>

    <div class="auth-links">
      <% if (!player) { %>
        <a href="/login">Login</a>
        <a href="/signup" class="signup">Sign up</a>
      <% } else { %>
        <span style="color:#fff; margin-right:10px;">Hi, <%= player.username %></span>
        <a href="/logout" class="signup" style="background:#ff4d4d;">Logout</a>
      <% } %>
    </div>
  </header>

  <!-- MOBILE MENU (SAME AS HOME) -->
  <div id="mobileMenu" class="mobile-menu">
    <div class="mobile-menu-content">
      <div class="mobile-close">&times;</div>

      <div class="mobile-search">
        <input type="text" placeholder="Search games..." />
      </div>

      <div class="mobile-nav-links">
        <a href="#">Newest</a>
        <a href="#">Most popular</a>
        <a href="#">Random</a>
      </div>

      <div class="mobile-auth">
        <% if (!player) { %>
          <a href="/login" class="login">Login</a>
          <a href="/signup" class="signup">Sign up</a>
        <% } else { %>
          <p style="color:#fff; font-size:15px; margin-bottom:10px;">
            Logged in as <b><%= player.username %></b>
          </p>
          <a href="/logout" class="signup" style="background:#ff4d4d;">Logout</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- PREMIUM LOGIN CARD -->
  <main class="auth-page">
    <div class="auth-card">
      <!-- <div class="auth-badge">🔥</div> -->
      <div class="auth-title">Welcome back</div>
      <div class="auth-subtitle">Sign in to continue playing on VillasGame</div>

      <% if (error) { %>
        <div class="errorBox"><%= error %></div>
      <% } %>

      <form action="/login" method="POST" novalidate>
        <div class="input-row">
          <label class="input-label" for="email"></label>
          <div class="input-wrapper">
            <span class="input-icon">📧</span>
            <input
              id="email"
              class="input-field"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="Email Address"
              required
            />
          </div>
        </div>

        <div class="input-row">
          <label class="input-label" for="password"></label>
          <div class="input-wrapper">
            <span class="input-icon">🔒</span>
            <input
              id="password"
              class="input-field"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Password"
              required
            />
          </div>
        </div>

        <button type="submit" class="primary-btn">Login</button>
      </form>

      <p class="auth-footer-text">
        New player?
        <a href="/signup">Create an account</a>
      </p>
    </div>
  </main>

  <!-- SAME FOOTER AS HOME -->
  <footer class="footer">
    <div class="footer-container">
      <div class="footer-logo">🔥 VillasGame</div>
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/terms">Terms & Conditions</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/contact">Contact</a>
      </div>
      <p class="footer-copy">© <%= new Date().getFullYear() %> VillasGame. All rights reserved.</p>
    </div>
  </footer>

  <!-- MOBILE MENU SCRIPT (same as index) -->
  <script>
    const mobileMenu = document.getElementById("mobileMenu");
    const menuContent = document.querySelector(".mobile-menu-content");

    document.querySelector(".hamburger").onclick = () => {
      mobileMenu.style.display = "flex";
      setTimeout(() => {
        menuContent.style.transform = "translateX(0)";
      }, 10);
    };

    document.querySelector(".mobile-close").onclick = () => {
      menuContent.style.transform = "translateX(100%)";
      setTimeout(() => { mobileMenu.style.display = "none"; }, 300);
    };

    mobileMenu.onclick = (e) => {
      if (e.target === mobileMenu) {
        menuContent.style.transform = "translateX(100%)";
        setTimeout(() => { mobileMenu.style.display = "none"; }, 300);
      }
    };
  </script>
</body>
</html>
